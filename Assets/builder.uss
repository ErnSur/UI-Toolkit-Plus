    white-space: pre-wrap;
}

.unity-builder-class-pill__delete-button {
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0 2px;
    margin: 0 -4px 0 0;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}

.unity-builder-class-pill__delete-button-icon {
    width: 14px;
    height: 14px;
    background-image: resource("UIBuilderPackageResources/Icons/Generic/Clear.png");
}

.unity-builder-class-pill__delete-button {
    background-image: none;
    background-color: initial;
    border-color: initial;
}

.unity-builder-class-pill__delete-button:active {
    background-image: none;
    background-color: initial;
    border-color: initial;
}

.unity-builder-class-pill__delete-button:hover {
    background-image: none;
    background-color: initial;
    border-color: initial;
}

.unity-builder-class-pill__delete-button:focus {
    background-image: none;
    background-color: initial;
    border-color: initial;
}

.unity-debugger-tree-item-pill.unity-builder-class-pill {
