    padding-top: 2px;
    padding-bottom: 2px;
}

.unity-builder-selector-label {
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: middle;
}

.unity-builder-selector-label-multiple-parts {
