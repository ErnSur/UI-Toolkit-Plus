    right: 0;
}

.unity-builder-resizer__side--horizontal .unity-builder-resizer__cursor-setter {
    cursor: resize-vertical;
}

.unity-builder-resizer__side--vertical .unity-builder-resizer__cursor-setter {
    cursor: resize-horizontal;
}

.unity-builder-resizer__corner--top-left .unity-builder-resizer__cursor-setter {
    cursor: resize-up-left;
}

.unity-builder-resizer__corner--top-right .unity-builder-resizer__cursor-setter {
    cursor: resize-up-right;
}

.unity-builder-resizer__corner--bottom-left .unity-builder-resizer__cursor-setter {
    cursor: resize-up-right;
}

.unity-builder-resizer__corner--bottom-right .unity-builder-resizer__cursor-setter {
    cursor: resize-up-left;
}

.unity-builder-transformer--disabled .unity-builder-resizer__cursor-setter {
    cursor: not-allowed;
}

.unity-builder-transformer--disabled .unity-builder-resizer__side__inner {
    background-color: var(--unity_builder-colors-canvas_transformer-background-disabled);
}

.unity-builder-transformer--disabled .unity-builder-resizer__corner__inner {
    background-color: var(--unity_builder-colors-canvas_transformer-background-disabled);
}

.unity-builder-anchorer {
    position: absolute;
    align-content: center;
    align-items: center;
    justify-content: center;
}

.unity-builder-anchorer__hover-zone {
    width: 12px;
    height: 12px;
    align-content: center;
    align-items: center;
    justify-content: center;
}

.unity-builder-anchorer__inner {
    width: 5px;
    height: 5px;
    border-width: 1px;
}

.unity-builder-anchorer--top {
    top: -34px;
    left: 0;
    right: 0;
}

.unity-builder-anchorer--left {
    top: 0;
    left: -34px;
    bottom: 0;
}

.unity-builder-anchorer--bottom {
    left: 0;
    right: 0;
    bottom: -34px;
}

.unity-builder-anchorer--right {
    top: 0;
    right: -34px;
    bottom: 0;
}

.unity-builder-dragger__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.unity-builder-dragger__container {
    position: absolute;
}

.unity-builder-dragger__empty-vs {
    border-width: 1px;
    width: 100px;
    height: 100px;
}

.unity-builder-dragger__drag-preview {
    opacity: 0.5;
}

.unity-builder-dragger--being-dragged {
    min-width: 100px;
    min-height: 20px;
}

.unity-builder-dragger--being-dragged.unity-list-view {
    max-height: 20px;
}

.unity-builder-dragger--being-dragged.unity-tree-view {
    max-height: 20px;
}

.unity-builder-dragger--being-dragged.unity-button {
    width: 100px;
}

.unity-builder-dragger--being-dragged.unity-base-field {
    width: 150px;
}

.unity-builder-dragger--being-dragged > .unity-base-field__label {
    min-width: 0;
    width: 90px;
}

.unity-builder-dragger--being-dragged .unity-composite-field__label {
    display: none;
}

.unity-style-field-popup {
    position: absolute;
    border-width: 1px;
    min-width: 250px;
    max-width: 400px;
    min-height: 20px;
    max-height: 250px;
    overflow: hidden;
}

.unity-style-field-popup--native-window {
    min-height: 20px;
    min-width: 10px;
    max-width: 1000px;
    max-height: 1000px;
}

.unity-style-field-popup * {
    flex-shrink: 0;
}

.unity-style-field-popup .unity-scroll-view__content-viewport {
    flex-shrink: 1;
}

.unity-style-field-popup .unity-scroll-view__content-and-vertical-scroll-container {
    flex-shrink: 1;
}

.unity-builder-tooltip-preview {
    position: absolute;
    margin-top: 1px;
}

.unity-builder-tooltip-preview__enabler {
    display: none;
    border-width: 1px;
}

.unity-builder-tooltip-preview__container {
    overflow: hidden;
    min-width: 250px;
    max-width: 450px;
    min-height: 20px;
    max-height: 400px;
    padding: 8px;
}

.unity-builder-tooltip-preview * {
    flex-shrink: 0;
}

.unity-builder-tooltip-preview .unity-scroll-view__content-viewport {
    flex-shrink: 1;
}

.unity-builder-tooltip-preview .unity-base-field__label {
    min-width: 0;
    width: 100px;
}

.unity-builder-tooltip-preview .unity-composite-field__label {
    display: none;
}

.unity-builder-variable-field .unity-text-field {
    margin: 0;
}

.unity-builder-inspector__varinfo-tooltip {
    align-content: center;
    -unity-text-align: middle-left;
}

.unity-builder-inspector__varinfo-tooltip .unity-builder-tooltip-preview__container {
    flex-grow: 1;
    padding: 0;
}

.unity-builder-inspector__varinfo-tooltip__warning {
    flex-direction: row;
    margin-top: 10px;
}

.unity-builder-inspector__varinfo-tooltip__warning Image {
    width: 16px;
    height: 16px;
}

.unity-builder-inspector__varinfo-view {
    padding: 4px;
}

.unity-builder-inspector__varinfo-view #top-section {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
}

.unity-builder-inspector__varinfo-view__row {
    flex-direction: row;
    align-items: center;
}

.unity-builder-inspector__varinfo-view__label {
    min-width: 80px;
    min-height: 16px;
    -unity-text-align: middle-left;
}

.unity-builder-inspector__varinfo-view__data-label {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
}

.unity-builder-inspector__varinfo-view__data-label--unresolved {
    opacity: 0.8;
    -unity-font-style: italic;
}

.unity-builder-inspector__varinfo-view #name-value-container {
    flex-grow: 1;
    flex-shrink: 1;
}

.unity-builder-inspector__varinfo-view #name-label {
    -unity-text-align: middle-left;
}

.unity-builder-inspector__varinfo-view #description-container {
    margin-top: 8px;
    flex-grow: 1;
}

.unity-builder-inspector__varinfo-view #stylesheet-label {
    flex-grow: 1;
}

.unity-builder-inspector__varinfo-view #description-label {
    flex-grow: 1;
    flex-wrap: nowrap;
    overflow: hidden;
    white-space: normal;
    min-height: 16px;
}

.unity-builder-inspector__varinfo-view__value-preview-container {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.unity-builder-inspector__varinfo-view__value-preview-container #preview {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    flex-shrink: 1;
    flex-grow: 0;
    margin-right: 4px;
    align-content: center;
    align-items: center;
    justify-content: center;
}

.unity-builder-inspector__varinfo-view__value-preview-container--thumbnail {
    flex-direction: column;
}

.unity-builder-inspector__varinfo-view__value-preview-container--thumbnail #preview {
    width: 50px;
    height: 50px;
    min-width: 50px;
    min-height: 50px;
    border-width: 1px;
    border-color: black;
}

.unity-builder-inspector__varinfo-view__value-preview-container #thumbnail {
    max-width: 48px;
    max-height: 48px;
    --unity-image-size: scale-to-fit;
}

.unity-field-search-completer-popup {
    flex-grow: 1;
    max-height: 400px;
    max-width: 1000px;
}

.unity-field-search-completer-popup .unity-list-view {
    flex: 1 1 0;
}

.unity-field-search-completer-popup__item {
    flex-direction: row;
}

.unity-field-search-completer-popup__item__name-label {
    -unity-text-align: middle-left;
    overflow: hidden;
    flex: 1 0 0;
    margin-left: 4px;
    margin-right: 4px;
    overflow: hidden;
    white-space: nowrap;
}

.unity-field-search-completer-popup .unity-list-view .unity-builder-tag-pill {
    height: 16px;
}

.unity-field-search-completer-popup__result-label {
    padding: 2px;
    -unity-text-align: middle-center;
}

.unity-field-search-completer-popup .unity-builder-inspector__varinfo-view {
    border-top-width: 1px;
}

.unity-field-search-completer-popup #previewContainer {
    border-width: 1px;
}

.unity-field-search-completer-popup__footer {
    border-top-width: 1px;
    border-top-color: var(--unity_builder-colors-field_search_completer_popup-border);
    background-color: var(--unity_builder-colors-field_search_completer_popup__footer-background);
}

.unity-field-search-completer-popup__details-view {
    padding: 4px;
    border-top-width: 1px;
    border-top-color: var(--unity_builder-colors-field_search_completer_popup-border);
    background-color: var(--unity_builder-colors-field_search_completer_popup__details_view-background);
}

.unity-field-search-completer-popup__details-view #top-section {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
}

.unity-field-search-completer-popup__details-view__row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
}

.unity-field-search-completer-popup__details-view__label {
    min-width: 80px;
    min-height: 16px;
    -unity-text-align: middle-left;
}

.unity-field-search-completer-popup__details-view__data-label {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.show-only-compatible-toggle {
    flex-direction: row;
    padding: 4px;
    border-top-width: 1px;
}

.show-only-compatible-toggle .unity-toggle__text {
    margin-left: 3px;
}

.unity-builder-code-row {
    flex-direction: row;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 16px;
    padding-right: 2px;
    min-height: 22px;
}

.unity-builder-code-row-header {
    min-height: 26px;
    -unity-font-style: bold;
}

.unity-builder-code-row-left-column-label {
    width: 118px;
}

.unity-builder-code-right-column {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.unity-builder-message-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-top: 10px;
}

.unity-builder-message-link {
    color: var(--unity-colors-link-text);
}

.unity-builder-content-box {
    margin-top: 10px;
    border-width: 1px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.unity-builder-code-example-code {
    -unity-font-definition: resource("Fonts/RobotoMono/RobotoMono-Regular SDF.asset");
    padding-left: 10px;
    margin-left: 0;
}

.unity-builder-code-example-description {
    flex-direction: row;
    padding-left: 10px;
    margin-top: 10px;
    flex-wrap: wrap;
    align-items: center;
}

.unity-builder-code-content-container {
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.unity-builder-selector-preview {
    flex-grow: 1;
}

.unity-builder-selector-preview__selector-text {
    flex-grow: 1;
}

.unity-builder-selector-preview__text-container {
    flex-grow: 1;
}

.unity-builder-selector-preview__checkerboard-background {
    --cell-size: 8;
}

.unity-builder-selector-preview__default-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.unity-builder-selector-preview__idle-label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-left: 50px;
    margin-right: 50px;
}

.unity-builder-selector-preview__toggle-icon {
    width: 20px;
    height: 18px;
    padding-top: 0;
    -unity-background-scale-mode: scale-to-fit;
    border-left-width: 1px;
    border-color: var(--unity-colors-toolbar-border);
    border-right-width: 0;
    background-size: 15px;
}

.unity-builder-selector-preview__window-toolbar {
    max-height: 20px;
    justify-content: flex-end;
}

.unity-builder-separator-line {
    flex-grow: 0;
    height: 2px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    opacity: 0.8;
    margin: 0 2px;
}

.unity-builder-uxml-object-button {
    padding-left: 6px;
}

.unity-builder-uxml-object-menu {
    font-size: 12px;
}

.unity-builder-type-field .unity-base-field__input {
    flex-direction: row;
}

.unity-builder-type-field__text {
    flex-shrink: 1;
    flex-grow: 1;
    align-self: center;
    overflow: hidden;
    text-overflow: ellipsis;
}

.unity-builder-type-field__button {
    -unity-font-style: normal;
}
